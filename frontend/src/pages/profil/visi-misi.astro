---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { profilData } from '../../data/profil';
---

<Base
	title="Visi, Misi & Motto"
	description="Pedoman dan komitmen pelayanan informasi publik Kementerian Agama Kabupaten Barito Utara."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="target"
			badge="Landasan Pelayanan"
			title="Visi, Misi & Motto PPID"
			subtitle="Pedoman dan komitmen pelayanan informasi publik Kementerian Agama Kabupaten Barito Utara."
		/>

		<section class="space-y-8">
			<div class="grid gap-6 md:grid-cols-2">
				<div class="p-8 rounded-3xl bg-emerald-500/5 border border-emerald-500/20 space-y-4">
					<h3 class="text-sm font-extrabold text-[#007144] uppercase tracking-wider">
						Visi Utama Layanan
					</h3>
					<p class="text-xl font-extrabold text-foreground leading-relaxed italic">
						&quot;{profilData.visi}&quot;
					</p>
				</div>

				<div class="p-8 rounded-3xl bg-amber-500/5 border border-amber-500/20 space-y-4">
					<h3 class="text-sm font-extrabold text-amber-700 uppercase tracking-wider">
						Motto Pelayanan
					</h3>
					<p class="text-xl font-extrabold text-foreground leading-relaxed italic">
						&quot;{profilData.motto}&quot;
					</p>
				</div>
			</div>

			<div class="p-8 rounded-3xl bg-card border border-border/60 shadow-xs space-y-6">
				<h3 class="text-xl font-extrabold text-foreground">Misi Pelayanan Informasi Publik</h3>
				<div class="grid gap-4 md:grid-cols-2">
					{
						profilData.misi.map((m) => (
							<div
								class="flex items-start gap-4 p-4 rounded-2xl bg-accent/30 border border-border/40"
							>
								<Icon
									name="check-circle"
									class="w-6 h-6 text-[#007144] shrink-0 mt-0.5"
								/>
								<span class="text-base font-semibold text-foreground leading-relaxed">
									{m}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</div>
</Base>