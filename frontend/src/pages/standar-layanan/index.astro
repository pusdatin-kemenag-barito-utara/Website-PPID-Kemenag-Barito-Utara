---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { standarLayananData } from '../../data/standar-layanan';
---

<Base
	title="Standar Pelayanan PPID"
	description="Komponen tolok ukur standar pelayanan publik yang dipergunakan sebagai pedoman penyelenggaraan."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="award"
			badge="Mutu Pelayanan"
			title="Standar Pelayanan PPID"
			subtitle="Komponen tolok ukur standar pelayanan publik yang dipergunakan sebagai pedoman penyelenggaraan."
		/>

		<section class="max-w-4xl mx-auto space-y-6">
			<div class="grid gap-4 sm:grid-cols-2">
				{
					standarLayananData.komponenStandar.map((ks, idx) => (
						<div
							class="p-6 rounded-3xl bg-card border border-border/60 shadow-xs flex items-start gap-4 hover:border-[#007144]/40 transition-all"
						>
							<div
								class="w-8 h-8 rounded-full bg-[#007144]/10 text-[#007144] font-extrabold flex items-center justify-center text-xs shrink-0 mt-0.5"
							>
								{idx + 1}
							</div>
							<p class="text-sm font-semibold text-foreground leading-relaxed">{ks}</p>
						</div>
					))
				}
			</div>
		</section>
	</div>
</Base>