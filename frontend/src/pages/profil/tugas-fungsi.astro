---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { profilData } from '../../data/profil';
---

<Base
	title="Tugas & Fungsi"
	description="Rincian tugas pokok dan fungsi operasional PPID Kementerian Agama Kabupaten Barito Utara."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="award"
			badge="Fungsi Organisasi"
			title="Tugas & Fungsi PPID"
			subtitle="Rincian tugas pokok dan fungsi operasional PPID Kementerian Agama Kabupaten Barito Utara."
		/>

		<section class="space-y-6">
			<div class="grid gap-5 sm:grid-cols-2">
				{
					profilData.tugasFungsi.map((tf, idx) => (
						<div
							class="p-6 rounded-3xl bg-card border border-border/60 shadow-xs flex items-start gap-4 hover:border-[#007144]/40 transition-all"
						>
							<div
								class="w-10 h-10 rounded-2xl bg-[#007144]/10 text-[#007144] font-extrabold flex items-center justify-center text-sm shrink-0"
							>
								{idx + 1}
							</div>
							<p class="text-base font-semibold text-foreground leading-relaxed">{tf}</p>
						</div>
					))
				}
			</div>
		</section>
	</div>
</Base>