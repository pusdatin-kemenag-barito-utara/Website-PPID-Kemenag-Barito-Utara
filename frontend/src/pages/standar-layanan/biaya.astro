---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { standarLayananData } from '../../data/standar-layanan';
---

<Base
	title="Biaya & Tarif Pelayanan"
	description="Ketentuan biaya pengajuan permohonan informasi publik (Gratis / Non Pungutan)."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="receipt"
			badge="Bebas Biaya"
			title="Biaya & Tarif Pelayanan"
			subtitle="Ketentuan biaya pengajuan permohonan informasi publik (Gratis / Non Pungutan)."
		/>

		<section class="max-w-4xl mx-auto space-y-6">
			<div class="p-8 rounded-3xl bg-card border border-border/60 shadow-xs space-y-6">
				<div
					class="p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-[#007144] font-extrabold text-lg text-center"
				>
					BEBAS BIAYA (RP 0,-)
				</div>

				<div class="space-y-4">
					{
						standarLayananData.biayaTarif.map((bt) => (
							<div
								class="p-4 rounded-2xl bg-accent/30 border border-border/40 flex items-start gap-4"
							>
								<Icon name="check-circle" class="w-5 h-5 text-[#007144] shrink-0 mt-0.5" />
								<span class="text-sm font-semibold text-foreground leading-relaxed">
									{bt}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</div>
</Base>