---
import Base from '../../layouts/Base.astro';
import AdminApp from '../../components/react/AdminApp';
import { getAdminUser } from '../../lib/admin-server';

const user = await getAdminUser(Astro.url.origin, Astro.request.headers.get('cookie') ?? '');
if (!user) {
	Astro.cookies.delete('ppid_admin_token', { path: '/' });
	return Astro.redirect('/pusdatin/auth');
}
---

<Base
	title="SOP Layanan – Admin PPID"
	description="Kelola Standard Operating Procedure (SOP) resmi pengelolaan dan pelayanan informasi publik Kemenag Barito Utara."
>
	<AdminApp page="sop" userEmail={user.email} userFullName={user.full_name} client:load />
</Base>
