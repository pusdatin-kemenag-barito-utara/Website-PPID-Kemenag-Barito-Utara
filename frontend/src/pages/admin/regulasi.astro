---
import Base from '../../layouts/Base.astro';
import AdminApp from '../../components/react/AdminApp';
import { getAdminUser } from '../../lib/admin-server';

const user = await getAdminUser(Astro.url.origin, Astro.request.headers.get('cookie') ?? '');
if (!user) return Astro.redirect('/404');
---

<Base
	title="Regulasi & SK – Admin PPID"
	description="Kelola arsip peraturan, undang-undang, PMA, KMA, dan SK yang terbit di portal publik."
>
	<AdminApp page="regulasi" userEmail={user.email} userFullName={user.full_name} client:load />
</Base>