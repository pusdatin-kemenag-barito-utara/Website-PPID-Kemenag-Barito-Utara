---
import Base from '../../layouts/Base.astro';
import AdminApp from '../../components/react/AdminApp';
import { getAdminUser } from '../../lib/admin-server';

const user = await getAdminUser(Astro.url.origin, Astro.request.headers.get('cookie') ?? '');
if (!user) return Astro.redirect('/404');
---

<Base
	title="Data Informasi & Statistik – Admin Kemenag"
	description="Kelola indikator data statistik capaian dan sajian infografis keagamaan portal PPID Kemenag Barito Utara."
>
	<AdminApp page="data-informasi" userEmail={user.email} userFullName={user.full_name} client:load />
</Base>
