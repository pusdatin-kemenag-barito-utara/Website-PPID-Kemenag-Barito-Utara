---
const origin = Astro.url.origin;
const cookieHeader = Astro.request.headers.get('cookie') ?? '';

const rawUpstream = process.env.API_UPSTREAM_URL || 'http://127.0.0.1:8080';
const upstream = rawUpstream.replace('://backend:', '://127.0.0.1:');

try {
	await fetch(`${upstream}/api/v1/auth/logout`, {
		method: 'POST',
		headers: { cookie: cookieHeader },
		signal: AbortSignal.timeout(2000),
	});
} catch {
	try {
		await fetch(`${origin}/api/v1/auth/logout`, {
			method: 'POST',
			headers: { cookie: cookieHeader },
			signal: AbortSignal.timeout(2000),
		});
	} catch {}
}

Astro.cookies.delete('ppid_admin_token', { path: '/' });
Astro.cookies.set('ppid_admin_token', '', { path: '/', expires: new Date(0), maxAge: 0 });
return Astro.redirect('/pusdatin/auth?logout=1');
---