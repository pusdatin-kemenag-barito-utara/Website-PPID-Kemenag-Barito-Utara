---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
---

<Base
	title="Struktur Organisasi"
	description="Bagan struktur hirarki dan koordinasi PPID Kementerian Agama Kabupaten Barito Utara."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="git-fork"
			badge="Bagan Organisasi"
			title="Struktur Organisasi PPID"
			subtitle="Bagan struktur hirarki dan koordinasi PPID Kementerian Agama Kabupaten Barito Utara."
		/>

		<section class="space-y-6">
			<div class="p-8 md:p-12 rounded-3xl bg-card border border-border/60 shadow-xs text-center space-y-8">
				<div class="max-w-2xl mx-auto space-y-2">
					<h2 class="font-extrabold text-2xl text-foreground">
						Bagan Struktur Pengelola Informasi & Dokumentasi
					</h2>
					<p class="text-sm text-muted-foreground">
						Bagan resmi susunan penanggung jawab, koordinator, dan tim pelaksana PPID
					</p>
				</div>

				<div
					class="p-16 rounded-2xl bg-accent/30 border border-dashed border-border/70 flex flex-col items-center justify-center gap-4"
				>
					<Icon name="git-fork" class="w-20 h-20 text-[#007144]/40" />
					<div class="space-y-1">
						<span class="text-sm font-bold text-foreground block">
							Bagan Grafik Struktur Organisasi PPID
						</span>
						<span class="text-xs text-muted-foreground block">
							Kantor Kementerian Agama Kabupaten Barito Utara
						</span>
					</div>
				</div>
			</div>
		</section>
	</div>
</Base>