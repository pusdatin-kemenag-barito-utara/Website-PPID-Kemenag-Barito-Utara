---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { standarLayananData } from '../../data/standar-layanan';
---

<Base
	title="Arah Kebijakan PPID"
	description="Pedoman dan arah kebijakan strategis keterbukaan informasi publik Kemenag Barito Utara."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="compass"
			badge="Arah Kebijakan"
			title="Arah Kebijakan PPID"
			subtitle="Pedoman dan arah kebijakan strategis keterbukaan informasi publik Kemenag Barito Utara."
		/>

		<section class="max-w-4xl mx-auto space-y-6">
			<div class="p-8 rounded-3xl bg-card border border-border/60 shadow-xs space-y-6">
				<h2 class="text-xl font-extrabold text-foreground">Fokus Arah Kebijakan Strategis</h2>
				<div class="space-y-4">
					{
						standarLayananData.arahKebijakan.map((ak) => (
							<div
								class="p-5 rounded-2xl bg-accent/30 border border-border/40 flex items-start gap-4"
							>
								<Icon name="check-circle" class="w-6 h-6 text-[#007144] shrink-0 mt-0.5" />
								<p class="text-sm md:text-base font-semibold text-foreground leading-relaxed">
									{ak}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>
	</div>
</Base>