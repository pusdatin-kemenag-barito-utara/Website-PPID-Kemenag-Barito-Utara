---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { standarLayananData } from '../../data/standar-layanan';
---

<Base
	title="Maklumat Pelayanan"
	description="Pernyataan komitmen dan sanggup melaksanakan pelayanan informasi publik sesuai standar."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="scroll"
			badge="Maklumat Pelayanan"
			title="Maklumat Pelayanan PPID"
			subtitle="Pernyataan komitmen dan sanggup melaksanakan pelayanan informasi publik sesuai standar."
		/>

		<section class="max-w-4xl mx-auto space-y-6">
			<div
				class="p-8 md:p-12 rounded-3xl bg-card border border-border/60 shadow-xs space-y-6 text-center"
			>
				<div
					class="w-16 h-16 rounded-full bg-emerald-500/10 text-[#007144] flex items-center justify-center mx-auto border border-[#007144]/20"
				>
					<Icon name="award" class="w-8 h-8" />
				</div>

				<h2 class="text-2xl font-extrabold tracking-tight text-foreground uppercase">
					MAKLUMAT PELAYANAN
				</h2>

				<div
					class="p-6 md:p-8 rounded-2xl bg-emerald-500/5 border border-emerald-500/20 text-base md:text-lg font-semibold text-foreground leading-relaxed italic"
				>
					&quot;{standarLayananData.maklumat}&quot;
				</div>

				<div
					class="pt-4 border-t border-border/40 text-xs text-muted-foreground flex items-center justify-center gap-2"
				>
					<Icon name="check-circle" class="w-4 h-4 text-[#007144]" />
					<span>Ditetapkan oleh Kepala Kantor Kementerian Agama Kabupaten Barito Utara</span>
				</div>
			</div>
		</section>
	</div>
</Base>