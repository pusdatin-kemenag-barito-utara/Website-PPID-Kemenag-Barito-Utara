---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import { standarLayananData } from '../../data/standar-layanan';
---

<Base
	title="Jadwal Pelayanan Informasi"
	description="Rincian hari dan jam operasional Meja Pelayanan Informasi PPID Kemenag Barito Utara."
>
	<div class="w-full px-4 md:px-8 lg:px-12 py-10 space-y-10">
		<Hero
			icon="calendar-days"
			badge="Waktu Operasional"
			title="Jadwal Pelayanan Informasi"
			subtitle="Rincian hari dan jam operasional Meja Pelayanan Informasi PPID Kemenag Barito Utara."
		/>

		<section class="max-w-4xl mx-auto space-y-6">
			<div class="grid gap-6 sm:grid-cols-3">
				{
					standarLayananData.jadwal.map((j) => (
						<div
							class="p-6 rounded-3xl bg-card border border-border/60 shadow-xs space-y-4 text-center hover:border-[#007144]/40 transition-all flex flex-col justify-between"
						>
							<div class="space-y-2">
								<div
									class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-[#007144] flex items-center justify-center mx-auto"
								>
									<Icon name="clock" class="w-6 h-6" />
								</div>
								<h3 class="font-extrabold text-base text-foreground">{j.hari}</h3>
							</div>

							<div class="space-y-1 pt-3 border-t border-border/40">
								<div class="text-sm font-extrabold text-[#007144]">{j.jam}</div>
								<div class="text-xs text-muted-foreground">Istirahat: {j.istirahat}</div>
							</div>
						</div>
					))
				}
			</div>
		</section>
	</div>
</Base>